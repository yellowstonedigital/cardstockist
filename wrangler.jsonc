{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cardstockist",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/img/*"]
  },
  "observability": { "enabled": true }
}

---
import Base from '../../../layouts/Base.astro';
import StoreCard from '../../../components/StoreCard.astro';
import CardGrid from '../../../components/CardGrid.astro';
import { getCollection, render } from 'astro:content';
import { gameBySlug } from '../../../data/games';
import { storesSelling } from '../../../lib/stores';
import { getCardSet, getSealed, nzd, trackLink } from '../../../lib/cards';

export async function getStaticPaths() {
  const sets = await getCollection('sets', ({ data }) => !data.draft);
  return sets.map((entry) => ({ params: { game: entry.data.game, set: entry.id.split('/').pop() }, props: { entry } }));
}
const { entry } = Astro.props;
const slug = entry.id.split('/').pop()!;
const game = gameBySlug(entry.data.game)!;
const { Content } = await render(entry);
const cardSet = getCardSet(entry.data.tcgdexId);
const sealed = getSealed(entry.data.sealed);
const t = entry.data.title;
const today = new Date(new Date().toDateString());
const released = entry.data.nzRelease ? entry.data.nzRelease <= today : true;
const date = entry.data.nzRelease?.toLocaleDateString('en-NZ', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

// Sealed: group by product, cheapest first.
const productOrder = ['Booster Box', 'Elite Trainer Box', 'Booster Bundle', 'Three-Pack Blister', 'One-Pack Blister', 'Booster Pack'];
const groups = [...new Set(sealed.map((r) => r.product))]
  .sort((a, b) => (productOrder.indexOf(a) + 1 || 99) - (productOrder.indexOf(b) + 1 || 99))
  .map((p) => ({ product: p, rows: sealed.filter((r) => r.product === p).sort((a, b) => a.priceNzd - b.priceNzd) }));
const statusLabel: Record<string, string> = { 'pre-order': 'Pre-order open', 'in-stock': 'In stock', 'sold-out': 'Sold out', 'coming-soon': 'Coming soon' };
const sealedChecked = sealed[0]?.checked ? new Date(sealed[0].checked + 'T00:00:00').toLocaleDateString('en-NZ', { day: 'numeric', month: 'long' }) : '';

const top = cardSet ? [...cardSet.cards].filter((c) => c.marketNzd != null).sort((a, b) => b.marketNzd! - a.marketNzd!).slice(0, 3) : [];
const stores = storesSelling(game.slug).filter((s) => s.type !== 'chain');
const storesShown = stores.filter((s) => s.featured).concat(stores.filter((s) => !s.featured)).slice(0, 9);

const title = cardSet ? `${t} card list, prices and where to buy in NZ` : `${t}: NZ release date, prices and where to buy`;
const description = cardSet
  ? `Every ${t} card with market prices in NZD, plus where to buy singles and sealed product in New Zealand.${top[0] ? ` Top card: ${top[0].name} (${nzd(top[0].marketNzd)}).` : ''}`
  : entry.data.description;
const schema = [{
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description, inLanguage: 'en-NZ',
  dateModified: cardSet?.fetchedAt ?? undefined,
}];
---
<Base
  title={title}
  description={description}
  crumbs={[{ name: game.short, href: `/nz/${game.slug}/where-to-buy/` }, { name: 'Releases', href: `/nz/${game.slug}/releases/` }, { name: t, href: Astro.url.pathname }]}
  schema={schema}
>
  <h1>{title}</h1>
  <p class="lede">{entry.data.description}</p>
  {date && <p class="note"><strong>{released ? 'Released in NZ:' : 'NZ release:'}</strong> {date}</p>}

  {top.length > 0 && (
    <p>The most valuable cards right now are {top.map((c, i) => <>{i > 0 && (i === top.length - 1 ? ' and ' : ', ')}<strong>{c.name}</strong> ({c.num}, {nzd(c.marketNzd)})</>)}.</p>
  )}

  {groups.length > 0 && (
    <>
      <h2>{t} prices in NZ</h2>
      <p>What NZ stores are charging{released ? '' : ' for pre-orders'}, cheapest first. Checked {sealedChecked}.</p>
      <div class="table-wrap"><table>
        <thead><tr><th>Product</th><th>Store</th><th>Price (NZD)</th><th>Status</th></tr></thead>
        <tbody>
          {groups.map((g) => g.rows.map((r, i) => (
            <tr>
              <td>{i === 0 ? <strong>{g.product}</strong> : ''}</td>
              <td><a href={trackLink(r.url, slug)} rel="noopener" target="_blank">{r.storeName}</a></td>
              <td>${r.priceNzd.toFixed(2)}</td>
              <td>{statusLabel[r.status] ?? r.status}</td>
            </tr>
          )))}
        </tbody>
      </table></div>
    </>
  )}

  {groups.length === 0 && entry.data.products.length > 0 && (
    <>
      <h2>Products</h2>
      <ul>{entry.data.products.map((p) => <li>{p.name}{p.rrp && ` (NZ RRP ${p.rrp})`}</li>)}</ul>
    </>
  )}

  <h2>{t} card list</h2>
  {cardSet
    ? <CardGrid set={cardSet} campaign={slug} />
    : <p class="note">The full card list with images and NZ prices goes up here on release day. Check back on {date ?? 'release day'}.</p>}

  <div class="prose"><Content /></div>

  <h2>Where to buy {t} in NZ</h2>
  <p>These NZ stores stock {game.short}. {released ? 'Most sell singles as well as sealed product.' : 'Most take pre-orders in the weeks before release.'}</p>
  <div class="grid">{storesShown.map((s) => <StoreCard store={s} highlight={game.slug} />)}</div>
  <p><a href={`/nz/${game.slug}/where-to-buy/`}>See all {stores.length} NZ stores that sell {game.short}</a></p>
</Base>
